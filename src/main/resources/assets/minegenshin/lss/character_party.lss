#root {
  background: sdf(#dd2c2c34, 5);
  width: 100%;
  height: 100%;
  flex-direction: row;
  display: flex;
  justify-content: center;
  align-items: center;
}


#character-party-container {
  width: 85%;
  height: 80%;
  flex-direction: row;
  overflow: hidden;
  display: flex;
  justify-content: space-evenly;
  align-items: center;
  padding-all: 20;
}
#character-button {
  width: 25%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.character-button-image-pose{
  height: 100%;
  aspect-rate: 0.75f;
  /* 居中 */
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  margin-all: auto;
}

#character-button-image-empty {
  width: 50%;
  aspect-rate: 1.0f;
  overlay: sprite(minegenshin:gui/character_party/add_character_button.png);
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  margin-all: auto;
}
