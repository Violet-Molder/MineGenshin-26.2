
#root {
    layout-direction: rtl;
}
#character_list {
    top: 20;
    padding-all: 5;
}
#character_state {
    flex-direction: row;

}
#character_icon {
    width: 40;
    height: 40;
    justify-content: left;
}
#icon-left {
    width: 100;
    flex-direction: column;
}
#character_name {
    width: auto;
    horizontal-align: RIGHT;
    width: 50%;
}
#character_party_hp {
    flex-grow: 0;
    layout-direction: ltr;
    fill-direction: LEFT_TO_RIGHT;
}

#current-content {
    justify-content: end;
    align-items: center;
    position: absolute;
}
#skill-content {
    bottom: 10;
    left: 170;
    flex-direction: row;
    layout-direction: ltr;
    width: 80;
}
skill-progress-bar {
    fill-direction: UP_TO_DOWN;
    interpolate: false;
}
#current_character_hp {
    width: 30%;
    bottom: 40;
    align-self: center;
    position: absolute;
    layout-direction: ltr;
    fill-direction: LEFT_TO_RIGHT;
    justify-content: center;
}
#character-level {
    right: 130;
    top: 2;
}
#character-attribute {
    bottom: 150;
}
boolean-bind-uie.__selected__{
    opacity: 1;
}
boolean-bind-uie.__unselected__ {
    opacity: 0;
}