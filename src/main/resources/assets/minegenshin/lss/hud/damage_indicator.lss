/* ============================================================
 * 伤害飘字 HUD 样式表
 * ============================================================ */

#damage-indicator-root {
    clip: none;
}

.damage-indicator {
}
.damage-indicator.crit {
}
.damage-indicator.reaction {
}
.damage-indicator.heal {
}
.damage-indicator.text {
}

/* ★ 渐变顶部层 wrapper：用垂直渐变压 mask
 *   wrapper 会遮罩自身 + 所有子元素，让子 Label 的文字
 *   只在 mask 上半部分可见 → 形成上→下颜色过渡
 *
 *   遮罩 PNG：assets/minegenshin/gui/damage_indicator_mask.png
 *   1×64 白色，顶部 alpha=255，底部 alpha=0
 */
.di-gradient-top {
    clip: mask;
    mask: sprite(minegenshin:gui/damage_indicator_mask1.png);
}
