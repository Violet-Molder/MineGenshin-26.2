custom-toggle > button.__toggle_button__ {
  base-background: rect(#4a4a4a);
  hover-background: rect(#5a5a5a);
}

custom-toggle {
  mark-background: rect(#477596);
}

custom-item-slot {
  aspect-rate: 1;
}

.row_container {
  flex-direction: row;
}

.category-toggle {
  width: 11%;
  height: 60%;
  align-items: center;
  justify-content: center;
}

.backpack-slot {
  width: 7.14%;
  aspect-rate: 1.0;
}

#backpack_slot {
  width: 7.14%;
  aspect-rate: 1.0;
}

#root {
  background: rect(#757575, 0);
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

#window {
  background: rect(#8a8a8a, 0);
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
}

#sidebar-panel {
  background: rect(#949494, 0);
  width: 100%;
  height: 10%;
  justify-content: center;
  align-items: center;
}

#category-section {
  width: 100%;
  height: 100%;
  justify-content: center;
  align-items: center;
}

#category_group {
  background: rect(#9e9e9e, 0);
  width: 100%;
  height: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
#content-panel {
  background: rect(#949494, 0);
  width: 100%;
  height: 90%;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
#backpack_container {
  background: rect(#9c9c9c, 0);
  width: 95%;
  height: 95%;
  flex-direction: row;
}

/* ========== 图标模式 ========== */
#icon-mode-section {
  width: 100%;
  height: 100%;
  flex-direction: row;
  display: flex;
}

#icon-genshin-backpack-window {
  width: 60%;
  height: 100%;
  flex-direction: row;
  display: flex;
  background: rect(#a8a8a8);
}

#icon-player-inventory-window {
  width: 40%;
  height: 100%;
  flex-direction: column;
  display: flex;
  background: rect(#a8a8a8);
}

/* ========== 图标模式 - 物品图标列表 ========== */
#icon-grid-container {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 4px;
  padding: 4px;
}

.backpack-icon-item {
  width: 12.5%;
  aspect-rate: 1;
  transition: transform 0.2 ease;  /* 平滑过渡 */
}

/* ========== 图标模式 - 详情面板 ========== */
#detail-panel-container {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 4px;
  gap: 2px;
}

.detail-line {
  font-size: 12px;
  color: #ffffff;
}

#slot-mode-section {
  width: 100%;
  height: 100%;
  flex-direction: row;
}
#mode-switch {
  position: absolute;
  top: 90%;
  left: 90%;
}

#genshin_backpack_window {
  background: rect(#a8a8a8);
  width: 60%;
  height: 100%;
  flex-direction: row;
}
#player_inventory_window {
  background: rect(#a8a8a8);
  width: 40%;
  height: 100%;
}

/* ========== 物品操作按钮 ========== */
#button-container {
  width: 100%;
  height: 10%;
  display: flex;
  flex-direction: row;
  gap: 4px;
  padding: 4px;
  justify-content: center;
  align-items: center;
}

.item-action-btn {
  width: 40%;
  height: 80%;
  background: rect(#5a7a9a);
  display: flex;
  justify-content: center;
  align-items: center;
}

.item-action-btn:hover {
  background: rect(#6a8aaa);
}

.item-action-btn:active {
  background: rect(#4a6a8a);
}


