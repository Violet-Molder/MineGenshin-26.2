custom-toggle > button.__toggle_button__ {
  base-background: rect(#4a4a4a);
  hover-background: rect(#5a5a5a);
}

custom-toggle {
  mark-background: rect(#477596);
}

.row_container {
  flex-direction: row;
}

.category-toggle {
  width: 11%;
  height: 60%;
  align-items: center;
  justify-content: center;
}


#root {
  background: rect(#757575, 0);
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

#window {
  background: rect(#8a8a8a, 0);
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
}

#sidebar-panel {
  background: rect(#949494, 0);
  width: 100%;
  height: 10%;
  justify-content: center;
  align-items: center;
}

#category-section {
  width: 100%;
  height: 100%;
  justify-content: center;
  align-items: center;
}

#category_group {
  background: rect(#9e9e9e, 0);
  width: 100%;
  height: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
#content-panel {
  background: rect(#949494, 0);
  width: 100%;
  height: 90%;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
#backpack_container {
  background: rect(#9c9c9c, 0);
  width: 95%;
  height: 95%;
  flex-direction: row;
}

#genshin_backpack_window {
  background: rect(#a8a8a8);
  width: 60%;
  height: 100%;
  flex-direction: row;
}
#player_inventory_window {
  background: rect(#a8a8a8);
  width: 40%;
  height: 100%;
}



