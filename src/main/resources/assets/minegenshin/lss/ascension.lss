#root {
  background: sdf(#dd2c2c34, 5);
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

#window {
  background: sdf(#cc333333, 8);
  width: 300;
  height: auto;
  padding-all: 12;
  gap-all: 6;
  flex-direction: column;
}

#ascension-title {
  font-size: 20;
  color: #FFD700;
  text-align: center;
  height: 24;
}

#adv-info-container {
  background: sdf(#44333333, 4);
  padding-all: 8;
  gap-all: 4;
  flex-direction: column;
}

#adv-rank-label {
  font-size: 14;
  color: #FFD700;
}

#adv-exp-label {
  font-size: 14;
  color: #CCFFCC;
}

#world-level-label {
  font-size: 14;
  color: #CCFFCC;
}

#adv-breakthrough-btn {
  background: sdf(#66885522, 3);
  height: 24;
  text-align: center;
  color: #FFD700;
}

#world-level-btn {
  background: sdf(#66446688, 3);
  height: 24;
  text-align: center;
  color: #AACCFF;
}

#char-info-container {
  background: sdf(#44333333, 4);
  padding-all: 8;
  gap-all: 4;
  flex-direction: column;
}

#char-exp-label {
  font-size: 14;
  color: #CCCCFF;
}

#char-level-label {
  font-size: 14;
  color: #CCCCFF;
}

#char-breakthrough-btn {
  background: sdf(#66885522, 3);
  height: 24;
  text-align: center;
  color: #FFD700;
}

#no-char-label {
  font-size: 14;
  color: #FF6666;
}