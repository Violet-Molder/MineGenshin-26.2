// panel

#root {
  background: sdf(#dd2c2c34, 5);
  width: 100%;
  height: 100%;
  flex-direction: row;
}
#character-view {
  height: 100%;
  flex-direction: row;
  padding-all: 5;
  layout-direction: rtl;
  overflow: hidden;

}
label {
  background: sdf(#ACCBD, 5);
}
#character-container {
  overflow: hidden;
}
#character-list-container {
  overflow: hidden;
  flex-shrink: 1;
  padding-all: 2;
}
#character-list {
  layout-direction: ltr;
  width: 210;
  height: 100%;
  padding-all: 5;
  gap-all: 4;
  flex-direction: row;
  flex-shrink: 1;
}
.character-avatar {
  width: 38; /* 计算后最优宽度 */
  height: 46; /* 宽高比263/319 → 38×319÷263≈46 */
  flex-shrink: 0;
  gap-all: 4;
  transform: scale(1); /* 默认缩放 */
  transition: transform 0.2 quad_in_out; /* 缩放过渡：时长0.2秒，缓动曲线 */
  transform-pivot: 0.5 0.5; /* 缩放锚点居中（避免偏移） */
}
.select-character{
  overlay: sprite(minegenshin:textures/character_avatar/selected_border.png)
}
.character-pose {
  aspect-rate: 0.75f;
  height: 90%;
  top: 10%;
  left: 10%;
}